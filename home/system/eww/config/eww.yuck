; ── Polls ──────────────────────────────────────────────────────────────
(defpoll clock-time :interval "1s"
  `date "+%H:%M:%S"`)

(defpoll clock-date :interval "60s"
  `date "+%A, %d %B %Y"`)

(defpoll cpu-usage :interval "2s"
  `awk 'NR==1{u1=$2+$4;t1=$2+$3+$4+$5+$6+$7+$8} NR==2{u2=$2+$4;t2=$2+$3+$4+$5+$6+$7+$8; printf "%.0f",(u2-u1)/(t2-t1)*100}' <(grep "^cpu " /proc/stat) <(sleep 0.5; grep "^cpu " /proc/stat)`)

(defpoll gpu-usage :interval "3s"
  `v=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | tr -d ' \n'); [ -n "$v" ] && echo "$v" || echo 0`)

(defpoll gpu-temp :interval "5s"
  `v=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | tr -d ' \n'); [ -n "$v" ] && echo "$v" || echo 0`)

(defpoll ram-used :interval "3s"
  `free -h | awk '/^Mem/{print $3}'`)

(defpoll ram-total :interval "60s"
  `free -h | awk '/^Mem/{print $2}'`)

(defpoll ram-percent :interval "3s"
  `free | awk '/^Mem/{printf "%.0f", $3/$2*100}'`)

(defpoll disk-info :interval "30s"
  `df -h / | awk 'NR==2{print $3"/"$2}'`)

(defpoll disk-percent :interval "30s"
  `df / | awk 'NR==2{printf "%.0f", $3/$2*100}'`)

(defpoll music-title :interval "2s"
  `playerctl metadata title 2>/dev/null || echo "Nothing playing"`)

(defpoll music-artist :interval "2s"
  `playerctl metadata artist 2>/dev/null || echo "—"`)

(defpoll music-album :interval "2s"
  `playerctl metadata album 2>/dev/null || echo ""`)

(defpoll music-status :interval "2s"
  `playerctl status 2>/dev/null || echo "Stopped"`)

(defpoll volume-level :interval "2s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%.0f", $2*100}'`)

(defpoll volume-muted :interval "2s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo "true" || echo "false"`)

; ── State ────────────────────────────────────────────────────────────────
(defvar active-tab "music")

; ── Tab Bar Widget ───────────────────────────────────────────────────────
(defwidget tab-bar []
  (box :class "tab-bar" :orientation "h" :homogeneous true :spacing 0
    (eventbox :class {active-tab == "music" ? "tab tab-active" : "tab"}
              :onclick "eww update active-tab=music"
      (label :text "󰎆  Music" :halign "center" :valign "center"))
    (eventbox :class {active-tab == "cal" ? "tab tab-active" : "tab"}
              :onclick "eww update active-tab=cal"
      (label :text "󰸗  Calendar" :halign "center" :valign "center"))
    (eventbox :class {active-tab == "sys" ? "tab tab-active" : "tab"}
              :onclick "eww update active-tab=sys"
      (label :text "󰊚  System" :halign "center" :valign "center"))))

; ── Music Tab ────────────────────────────────────────────────────────────
(defwidget music-tab []
  (box :visible {active-tab == "music"} :class "tab-content music-section" :orientation "h" :space-evenly false :spacing 24
    (box :orientation "v" :space-evenly false :spacing 14 :hexpand true :valign "center"
      (box :orientation "v" :space-evenly false :spacing 5
        (label :class "music-title"  :halign "start" :text music-title  :limit-width 30 :wrap false)
        (label :class "music-artist" :halign "start" :text music-artist :limit-width 30 :wrap false)
        (label :class "music-album"  :halign "start" :text music-album  :limit-width 30 :wrap false))
      (box :class "controls" :orientation "h" :halign "start" :space-evenly false :spacing 6
        (button :class "ctrl-btn" :onclick "playerctl previous"   "󰒮")
        (button :class "ctrl-btn play" :onclick "playerctl play-pause"
          {music-status == "Playing" ? "󰏤" : "󰐊"})
        (button :class "ctrl-btn" :onclick "playerctl next"       "󰒭")
        (button :class "ctrl-btn" :onclick "playerctl stop"       "󰓛"))
      (box :class "volume-row" :orientation "h" :space-evenly false :spacing 8
        (button :class "vol-btn"
                :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
          {volume-muted == "true" ? "󰝟" : "󰕾"})
        (scale :class "vol-slider" :value volume-level :min 0 :max 100 :hexpand true
               :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
        (label :class "vol-label" :text "${volume-level}%")))
    (image :class "frog" :valign "center" :path "${EWW_CONFIG_DIR}/frog.gif")))

; ── Calendar Tab ─────────────────────────────────────────────────────────
(defwidget cal-tab []
  (box :visible {active-tab == "cal"} :class "tab-content cal-section" :orientation "v" :space-evenly false :spacing 10
    (box :class "clock-block" :orientation "v" :space-evenly false :spacing 0
      (label :class "clock" :halign "start" :text clock-time)
      (label :class "date"  :halign "start" :text clock-date))
    (calendar :class "cal" :hexpand true
      :show-day-names true
      :show-heading true
      :show-week-numbers false)))

; ── System Tab ───────────────────────────────────────────────────────────
(defwidget sys-tab []
  (box :visible {active-tab == "sys"} :class "tab-content stats-section" :orientation "h" :space-evenly false :spacing 24
    (box :orientation "v" :space-evenly false :spacing 14 :hexpand true :valign "center"
      (box :class "sys-clock-row" :orientation "h" :halign "start"
        (label :class "clock-small" :text clock-time))

      (box :class "stat" :orientation "v" :space-evenly false :spacing 4
        (box :orientation "h" :space-evenly false :spacing 0
          (label :class "stat-label" :text "󰻠  CPU")
          (label :class "stat-value" :halign "end" :hexpand true :text "${cpu-usage}%"))
        (progress :class "stat-bar cpu-bar" :value cpu-usage :min 0 :max 100))

      (box :class "stat" :orientation "v" :space-evenly false :spacing 4
        (box :orientation "h" :space-evenly false :spacing 0
          (label :class "stat-label" :text "󰢮  GPU")
          (label :class "stat-value" :halign "end" :hexpand true :text "${gpu-usage}%  ${gpu-temp}°C"))
        (progress :class "stat-bar gpu-bar" :value gpu-usage :min 0 :max 100))

      (box :class "stat" :orientation "v" :space-evenly false :spacing 4
        (box :orientation "h" :space-evenly false :spacing 0
          (label :class "stat-label" :text "󰍛  RAM")
          (label :class "stat-value" :halign "end" :hexpand true :text "${ram-used} / ${ram-total}"))
        (progress :class "stat-bar ram-bar" :value ram-percent :min 0 :max 100))

      (box :class "stat" :orientation "v" :space-evenly false :spacing 4
        (box :orientation "h" :space-evenly false :spacing 0
          (label :class "stat-label" :text "󰋊  SSD")
          (label :class "stat-value" :halign "end" :hexpand true :text disk-info))
        (progress :class "stat-bar disk-bar" :value disk-percent :min 0 :max 100)))))

; ── Content widget ───────────────────────────────────────────────────────
(defwidget dashboard-content []
  (box :class "dashboard" :orientation "v" :spacing 0
    (music-tab)
    (cal-tab)
    (sys-tab)))

; ── Window 1: Tab bar (38px tall, pinned) ────────────────────────────────
(defwindow dashboard-tabs
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "56px"
    :width "700px"
    :height "38px"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (tab-bar))

; ── Window 2: Content (starts right below tab bar) ───────────────────────
(defwindow dashboard
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "94px"
    :width "700px"
    :height "390px"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (dashboard-content))
